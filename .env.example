# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# CloudHike.dev Postgres (deployed through the CloudHike MCP server)
DATABASE_URL=postgresql://user:password@host:port/database
DIRECT_URL=postgresql://user:password@host:port/database

# AI models (OpenAI-compatible). Server only — never prefix with NEXT_PUBLIC_.
# CloudHike AI card: deploy AI models, then paste its two values here. The
# service serves GPT, Claude, Gemini, Grok, DeepSeek, Qwen and hundreds more,
# and lists them at GET $AI_BASE_URL/models.
AI_BASE_URL=
AI_API_KEY=your-api-key
# The default built-in model, also used when a saved model is unusable.
# Ids are named provider/model — see https://cloudhike.dev/docs/ai#models
AI_MODEL=openai/gpt-5.4
# Optional: extra built-in models to offer in the pickers, comma separated.
# The picker lists whatever GET {AI_BASE_URL}/models returns; a curated list is
# used when AI_BASE_URL or the call is missing.
AI_MODELS=
# Optional: "chat_completions" | "responses". Defaults to chat_completions
# when AI_BASE_URL is set, responses otherwise.
AI_API=
# Optional: encrypts keys users connect in the app. Falls back to AUTH_SECRET_KEY.
AI_SECRET_KEY=
# Optional: "low" | "medium" | "high" reasoning effort for gpt-5 / o-series models
AGENT_REASONING_EFFORT=

# Web search for the agent's web_search tool. By default it searches through
# the same AI connection as chat (AI_BASE_URL + AI_API_KEY) with a search-capable
# model, so no separate OpenAI key is needed.
AI_SEARCH_MODEL=
# Optional fallback key for OpenAI-hosted search only when the selected model is
# a direct OpenAI connection. Not needed when AI_BASE_URL is configured.
OPENAI_API_KEY=

# Models users connect themselves (label, base URL, model id, API key) are added
# in the app and stored encrypted in Postgres — no env vars needed for those.
#
# OPENAI_API_KEY / OPENAI_BASE_URL are still read as fallbacks, and the older
# AGENT_<PROVIDER>_* overrides keep working for agents created before model keys.
# AGENT_CLAUDE_BASE_URL=
# AGENT_CLAUDE_API_KEY=
# AGENT_CLAUDE_MODEL=

# Browserbase Cloud Browser (the agent's browser_* tools). Server only.
# A session is started by the first browser tool call in a reply, attached to
# the owner's persistent Context (so their logins survive), and released when
# the reply is done. Without these the browser tools explain they are off.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Optional: Stagehand's own model, billed through Browserbase's Model Gateway
# (default google/gemini-2.5-flash). Needs no separate provider key.
BROWSERBASE_MODEL=
# Optional: step limit for one agent turn. Default 8, or 16 when the agent has
# cloud-browser tools (each click/scroll/read is a step).
AGENT_MAX_TURNS=

# Agent schedules: point a timer (Vercel Cron, GitHub Actions…) at
# GET /api/cron/agents with `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=

# CloudHike.dev Background Jobs Scheduler: when both are set and the app has a
# public HTTPS origin, every agent task and widget update gets its own recurring
# Jobs schedule. Jobs calls back POST /api/jobs/schedules or /api/jobs/widgets
# (signed with x-cloudhike-signature); long browser runs fit in its timeout.
JOBS_API_URL=
JOBS_API_KEY=
# Optional: public HTTPS origin Jobs should call when NEXT_PUBLIC_APP_URL is
# localhost (for example a tunnel). Without it, local dev keeps the cron fallback
# and the UI shows why the Jobs schedule is not created yet.
JOBS_APP_ORIGIN=

# Optional: email the workspace owner when a scheduled agent run fails.
# Resend API key + a verified sender. Unset = alerts stay in the header bell.
RESEND_API_KEY=
SCHEDULE_ALERT_FROM=Alcatraz dev <onboarding@resend.dev>

# CloudHike.dev Auth
AUTH_URL=https://cloudhike.dev/api/auth-service/<project-slug>
AUTH_PUBLISHABLE_KEY=your-publishable-key
# Server only. Never expose to the browser.
AUTH_SECRET_KEY=your-secret-key

# Composio: external app connections (Gmail, Slack, Notion, GitHub, …).
# Project key from https://dashboard.composio.dev. Server only — it can mint
# connect links and open tool sessions for every user in the project.
COMPOSIO_API_KEY=
# Encrypts the single-use approval tokens for app actions that change data
# (AES-256-GCM). Server only. Falls back to AUTH_SECRET_KEY when unset.
AGENT_SECRETS_KEY=
# affectUI registry key for Pro items (Account → Downloads). components.json
# sends it as `Authorization: Bearer ${AFFECTUI_TOKEN}` to @affectui; without
# it every Pro slug (chat-composer, approval-card, chat-composer-clean, …)
# answers 401. Only needed at install time, not by the running app.
AFFECTUI_TOKEN=
